# Copy this file to .env and replace the placeholder before starting Docker Compose.
CLAIMS_DB_NAME=claims
CLAIMS_DB_USERNAME=claims_app
CLAIMS_DB_PASSWORD=replace-with-a-local-password
RABBITMQ_USERNAME=claims_app
RABBITMQ_PASSWORD=replace-with-another-local-password

# Optional: uncomment only when running the claim-summary worker with its OpenAI provider.
# OPENAI_API_KEY=replace-with-your-openai-api-key
